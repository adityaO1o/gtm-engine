# Copy to .env for local dev. On Dokploy, set these in the Environment tab instead.

PORT=3001

# Shared secret — Trigify must send this as the x-ingest-token header on /enrich
INGEST_TOKEN=pick-a-long-random-string

# Mongo (local dev). In compose this is mongodb://mongo:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=gtm

# API keys
PROSPEO_KEY=pk_xxx
ENRICH_KEY=sk_live_xxx
SENDKIT_KEY=sk_xxx

# Proxies: newline-separated http://user:pass@host:port  (or drop a proxies.txt at repo root)
PROXIES=

PROXY_TIMEOUT_MS=20000
SCRAPE_RETRIES=4

# The Blacklist Project (InboxKit's own DNSBL checker) — used by the domain-prospecting scan
BLACKLIST_API_KEY=blp_xxx
BLACKLIST_WORKSPACE_ID=6a70cb4a7333fe7c8331cca7
BLACKLIST_API_BASE=http://163.123.236.189:4400

SCAN_DNS_CONCURRENCY=1000
SCAN_REDIRECT_CONCURRENCY=250
SCAN_REDIRECT_TIMEOUT_MS=5000
SCAN_DNS_TIMEOUT_MS=3000

# host.io reverse-redirect index (default discovery source for the domain scan)
HOSTIO_TOKEN=your_hostio_token
HOSTIO_PAGE_CONCURRENCY=10

# dns.lookup() runs on libuv's threadpool (default size 4) — raise this or DNS concurrency in the
# domain scan silently caps at 4 no matter what SCAN_DNS_CONCURRENCY says. Already set in Dockerfile
# for deploys; only needed here for local dev.
UV_THREADPOOL_SIZE=128
