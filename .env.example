# Copy to .env for local dev. On Dokploy, set these in the Environment tab instead.

PORT=3001

# Shared secret — Trigify must send this as the x-ingest-token header on /enrich
INGEST_TOKEN=pick-a-long-random-string

# Mongo (local dev). In compose this is mongodb://mongo:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=gtm

# API keys
PROSPEO_KEY=pk_xxx
ENRICH_KEY=sk_live_xxx
SENDKIT_KEY=sk_xxx

# Proxies: newline-separated http://user:pass@host:port  (or drop a proxies.txt at repo root)
PROXIES=

PROXY_TIMEOUT_MS=20000
SCRAPE_RETRIES=4
